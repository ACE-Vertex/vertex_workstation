{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vertex Workstation",
  "version": "0.1.0",
  "identifier": "net.a-portal.vertex.workstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vertex Workstation",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
